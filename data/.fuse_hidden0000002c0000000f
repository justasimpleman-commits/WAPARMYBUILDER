  // Lore of Nehekhara — the Tomb Kings' own lore.
  spellLores: {
    "Nehekhara": { attribute: { name: "The Restless Dead", text: `Each time a Wizard successfully casts an augment or conveyance spell from the Lore of Nehekhara, the target immediately recovers a number of Wounds' worth of models, just like a summoning spell: Core Units (except Chariots) recover D6+1 Wounds; Special Units, Chariots and Monstrous Cavalry recover D3 Wounds; remaining Rare Units recover 1 Wound.` }, spells: [
      { name: "Khsar's Incantation of the Desert Wind", lvl: 0, cast: 5, type: "Conveyance", range: `24"`, effect: `The target may immediately make a normal move as if it were the Remaining Moves sub-phase.` },
      { name: "Djedra's Incantation of the Eternal Dead", lvl: 1, cast: 5, type: "Augment (RIP)", range: `Self`, effect: `Remains in play. Cast on the Wizard itself (can trigger The Restless Dead for its unit). While in effect, add +1 to all Wounds recovered from The Restless Dead due to spells cast by this Wizard.` },
      { name: "Sekhubi's Incantation of Retribution", lvl: 1, cast: 5, type: "Magic missile", range: `30"`, effect: `D6 Strength 4 hits.` },
      { name: "Djaf's Incantation of Cursed Blades", lvl: 1, cast: 6, type: "Augment", range: `18"`, effect: `The target unit's close combat Attacks gain the Killing Blow special rule until the start of your next Magic phase.` },
      { name: "Merneptah's Incantation of the Scarab Song", lvl: 2, cast: 8, type: "Direct damage (area)", range: `24"`, effect: `Large round template. All models under the template suffer a Strength 1 hit with the Poisoned Attacks special rule.` },
      { name: "Ptra's Incantation of Righteous Smiting", lvl: 2, cast: 8, type: "Augment", range: `18"`, effect: `All models in the target unit gain +1 Attack and may fire an additional shot with missile weapons (excluding artillery) until the start of the caster's next Magic phase.` },
      { name: "Neru's Incantation of Protection", lvl: 2, cast: 10, type: "Augment", range: `18"`, effect: `The target unit gains a Magical Ward (5+) until the start of the caster's next Magic phase.` },
      { name: "Return of the Golden Age", lvl: 3, cast: 10, type: "Augment", range: `18"`, effect: `The target unit gains +1 Weapon Skill, Strength and Initiative until the start of the caster's next Magic phase.` },
      { name: "Usirian's Incantation of Vengeance", lvl: 3, cast: 10, type: "Hex", range: `24"`, effect: `The target unit suffers -D3 to its Movement (min 1) and treats all terrain (even open ground) as Dangerous Terrain, testing every time it moves, until the start of the caster's next Magic phase.` },
      { name: "Neferre's Incantation of Quaking Horror", lvl: 3, cast: 12, type: "Hex", range: `24"`, effect: `The target halves its Leadership (after modifiers, rounding up) until the start of the caster's next Magic phase.` },
      { name: "Usekhp's Incantation of Desiccation", lvl: 4, cast: 12, type: "Hex", range: `24"`, effect: `The target unit has -1 Strength and -1 Toughness (min 1) until the start of the caster's next Magic phase.` },
      { name: "Mankara's Incantation of Urgency", lvl: 4, cast: 13, type: "Conveyance", range: `12"`, effect: `The target may immediately move using the Random Movement (3D6) special rule.` },
      { name: "Sakhmet's Incantation of the Skullstorm", lvl: 4, cast: 15, type: "Vortex (RIP)", range: `Small template`, effect: `Remains in play. A magical vortex using the small round template; any model touched at any point during its move suffers a Strength 5 hit. Any unit suffering one or more casualties takes an immediate Panic test.` }
    ]}
  },

